@@ -0,0 +1,41 @@
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+
+import { describe, expect, it } from 'vitest';
+
+/**
+ * 0019 — A NARROW FILES PANE PUTS THE FILE UNDER THE TREE.
+ *
+ * The accessibility audit: Architecture opens at boot, so clicking Files at
+ * 1440px sets the two side by side at 299px each. Only a WINDOW query
+ * (max-width: 720px) collapsed the two columns, so the tree kept its 280px and
+ * the reading column (.files-body) was 19px wide, its note one letter a line.
+ *
+ * jsdom has no layout and no container queries, so these READ THE STYLESHEETS,
+ * as filesHeaderFit does. The measurement in Chromium is the audit probe
+ * (.files-body width beside Architecture at 1440px: 19px before, 299px after).
+ */
+const files = readFileSync(resolve(__dirname, 'files.css'), 'utf8');
+const v3 = readFileSync(resolve(__dirname, '..', 'v3', 'v3.css'), 'utf8');
+const block = (css: string, head: string): string => {
+  const at = css.indexOf(head);
+  expect(at, `${head} is present`).toBeGreaterThanOrEqual(0);
+  return css.slice(at, css.indexOf('\n}\n', at));
+};
+
+describe('the Files panel in a narrow pane', () => {
+  it('the V3 shell makes the Files pane a size container', () => {
+    expect(block(v3, '.v3-files-wrap {')).toMatch(/container:\s*filespane\s*\/\s*inline-size/);
+  });
+
+  it('collapses to the tree over the file when the PANE is under 520px, as the window rule does', () => {
+    const pane = block(files, '@container filespane (max-width: 520px)');
+    const windowRule = block(files, '@media (max-width: 720px)');
+    const template = (b: string) => /\.files-scope \{([^}]*)\}/.exec(b)?.[1]?.trim();
+    expect(template(pane)).toMatch(/grid-template-columns:\s*minmax\(0, 1fr\)/);
+    expect(template(pane)).toMatch(/grid-template-rows:\s*minmax\(0, 12rem\) minmax\(0, 1fr\)/);
+    expect(template(pane)).toBe(template(windowRule));
+    /* After the base two-column rule, or it wins the cascade. */
+    expect(files.indexOf('@container filespane')).toBeGreaterThan(files.indexOf('.files-scope {'));
+  });
+});
