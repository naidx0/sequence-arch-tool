@@ -0,0 +1,110 @@
+/* ══════════════════════════════════════════════════════════════════════════
+   ONE GET OF /api/sessions, NOT SEVENTEEN
+   packages/web2/src/sessions/sessionsListOnce.test.tsx
+
+   Measured on 0.1.2 in Chromium (tools/measure/surface-load.mjs): 17 GETs of
+   /api/sessions at boot and 2 to 4 on every workspace tab click. The causes:
+   the shell and the rail made a new sessions client on every render, which
+   re-ran the rail's list effect on every render; that effect asked twice (the
+   index and the catalog); and the store's index hydrate asked a third time.
+   ══════════════════════════════════════════════════════════════════════════ */
+
+import { render, waitFor } from '@testing-library/react';
+import { describe, expect, it } from 'vitest';
+
+import { createStore, StoreProvider } from '../state';
+import { V3SessionsRail } from '../v3/V3SessionsRail';
+import { createSessionsClient } from './sessionsClient';
+
+const INDEX = {
+  version: 1,
+  activeId: 'session-a',
+  sessions: [{ id: 'session-a', title: 'a', createdAt: '2026-09-23T09:00:00.000Z', updatedAt: '2026-09-23T09:00:00.000Z' }],
+};
+
+function countingFetch() {
+  const gets: string[] = [];
+  let release: (() => void) | undefined;
+  let gate: Promise<void> | undefined;
+  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = String(input);
+    const method = (init?.method ?? 'GET').toUpperCase();
+    if (method === 'GET') gets.push(url);
+    if (gate) await gate;
+    if (url === '/api/sessions' && method === 'GET') {
+      return new Response(
+        JSON.stringify({ index: INDEX, scope: 'workspace', repos: [{ path: '/r', name: 'r', index: INDEX }] }),
+        { status: 200, headers: { 'content-type': 'application/json' } },
+      );
+    }
+    return new Response('{}', { status: 200, headers: { 'content-type': 'application/json' } });
+  }) as typeof fetch;
+  return {
+    fetchImpl,
+    gets,
+    hold() {
+      gate = new Promise<void>((r) => (release = r));
+    },
+    release() {
+      gate = undefined;
+      release?.();
+    },
+  };
+}
+
+describe('the sessions list is asked for once at a time', () => {
+  it('concurrent list() calls share one request; a later call fetches fresh', async () => {
+    const wire = countingFetch();
+    const a = createSessionsClient(wire.fetchImpl);
+    const b = createSessionsClient(wire.fetchImpl);
+    wire.hold();
+    const both = Promise.all([a.list(), b.list(), a.list()]);
+    wire.release();
+    const answers = await both;
+    expect(wire.gets.filter((u) => u === '/api/sessions')).toHaveLength(1);
+    expect(answers.every((x) => x.outcome === 'ok')).toBe(true);
+
+    await a.list();
+    expect(wire.gets.filter((u) => u === '/api/sessions')).toHaveLength(2);
+  });
+
+  it('one caller aborting gets "cancelled" and does not cancel the others', async () => {
+    const wire = countingFetch();
+    const client = createSessionsClient(wire.fetchImpl);
+    const gone = new AbortController();
+    wire.hold();
+    const first = client.list(gone.signal);
+    const second = client.list();
+    gone.abort();
+    wire.release();
+    const [x, y] = await Promise.all([first, second]);
+    expect(x).toMatchObject({ outcome: 'error', message: 'cancelled' });
+    expect(y.outcome).toBe('ok');
+    expect(wire.gets.filter((u) => u === '/api/sessions')).toHaveLength(1);
+  });
+
+  it('two separate fetches never share a request', async () => {
+    const one = countingFetch();
+    const two = countingFetch();
+    await Promise.all([createSessionsClient(one.fetchImpl).list(), createSessionsClient(two.fetchImpl).list()]);
+    expect(one.gets).toHaveLength(1);
+    expect(two.gets).toHaveLength(1);
+  });
+
+  it('the rail fills both the index and the catalog from one GET, and re-renders fetch nothing', async () => {
+    const wire = countingFetch();
+    const client = createSessionsClient(wire.fetchImpl);
+    const store = createStore();
+    const view = (
+      <StoreProvider store={store}>
+        <V3SessionsRail client={client} />
+      </StoreProvider>
+    );
+    const { rerender, container } = render(view);
+    await waitFor(() => expect(store.getState().session.activeId).toBe('session-a'));
+    await waitFor(() => expect(container.textContent).toContain('r'));
+    for (let i = 0; i < 5; i += 1) rerender(view);
+    await new Promise((r) => setTimeout(r, 20));
+    expect(wire.gets.filter((u) => u === '/api/sessions')).toHaveLength(1);
+  });
+});
