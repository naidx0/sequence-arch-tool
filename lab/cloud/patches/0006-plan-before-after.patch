+/* ======================================== plan mode before/after floor ===== */
+
+const PLAN_ANSWER = [
+  'Plan: add an order status endpoint.',
+  '',
+  '1. `orders/app/routes.py` — add a `GET /orders/{id}/status` route.',
+  '2. Update gateway/src/routes/orders.ts to forward the status call.',
+  '3. Verify with the gateway route test.',
+].join('\n');
+
+async function planTurnEvents(permission: 'plan' | 'build', flag: string | undefined) {
+  const repo = shopfrontRepo();
+  const { callProvider } = makeProviderScript([{ text: PLAN_ANSWER }]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const before = process.env.SEQUENCE_PLAN_BEFORE_AFTER;
+  if (flag === undefined) delete process.env.SEQUENCE_PLAN_BEFORE_AFTER;
+  else process.env.SEQUENCE_PLAN_BEFORE_AFTER = flag;
+  try {
+    const events: AskStreamEvent[] = [];
+    await runAskPipeline({ ...base, question: 'Plan an order status endpoint', permission }, (e) => events.push(e));
+    return events;
+  } finally {
+    if (before === undefined) delete process.env.SEQUENCE_PLAN_BEFORE_AFTER;
+    else process.env.SEQUENCE_PLAN_BEFORE_AFTER = before;
+  }
+}
+
+test('askPipeline plan mode, SEQUENCE_PLAN_BEFORE_AFTER=1: a plan naming scanned files draws its before/after', async () => {
+  const events = await planTurnEvents('plan', '1');
+  const charts = events.filter((e) => e.type === 'chart:proposal') as { chart: { kind: string; items: { label: string; group?: string }[] } }[];
+  assert.strictEqual(charts.length, 1);
+  assert.strictEqual(charts[0]!.chart.kind, 'before-and-after');
+  assert.deepStrictEqual(
+    charts[0]!.chart.items.map((i) => `${i.group}:${i.label}`),
+    ['Before:routes.py', 'Before:orders.ts', 'After:routes.py', 'After:orders.ts'],
+  );
+  const done = events.find((e) => e.type === 'tool:done' && (e as { id?: string }).id?.startsWith('plan-before-after')) as { evidence?: string } | undefined;
+  assert.match(done?.evidence ?? '', /from the files the plan names/);
+});
+
+test('askPipeline plan before/after stays off without the flag, and never fires outside plan mode', async () => {
+  for (const [permission, flag] of [['plan', undefined], ['build', '1']] as const) {
+    const events = await planTurnEvents(permission, flag);
+    const kinds = events.filter((e) => e.type === 'chart:proposal').map((e) => (e as { chart: { kind: string } }).chart.kind);
+    assert.ok(!kinds.includes('before-and-after'), `${permission} with flag ${flag ?? 'unset'} drew a before/after`);
+  }
+});
