+async function handBackTeachTurn(flag: string | undefined) {
+  const repo = shopfrontRepo();
+  const HAND_BACK = 'I have looked at the scan. Can you confirm which files you want me to cover?';
+  const { callProvider } = makeProviderScript([
+    {
+      text: 'Drawing the services.',
+      toolRequests: [
+        {
+          id: 'c1',
+          name: 'propose_chart',
+          args: {
+            kind: 'system-architecture',
+            title: 'How an order gets in',
+            items: [
+              { id: 'g', label: 'orders.ts', nodeId: 'file:gateway/src/routes/orders.ts' },
+              { id: 'o', label: 'routes.py', nodeId: 'file:orders/app/routes.py' },
+            ],
+            links: [{ from: 'g', to: 'o', label: 'HTTP' }],
+          },
+        },
+      ],
+    },
+    { text: HAND_BACK },
+  ]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const before = process.env.SEQUENCE_TEACH_DEFLECT_FLOOR;
+  if (flag === undefined) delete process.env.SEQUENCE_TEACH_DEFLECT_FLOOR;
+  else process.env.SEQUENCE_TEACH_DEFLECT_FLOOR = flag;
+  try {
+    return await runAskPipeline({ ...base, question: 'Teach me how an order gets into the system', teach: true }, () => {});
+  } finally {
+    if (before === undefined) delete process.env.SEQUENCE_TEACH_DEFLECT_FLOOR;
+    else process.env.SEQUENCE_TEACH_DEFLECT_FLOOR = before;
+  }
+}
+
+test('askPipeline teach, SEQUENCE_TEACH_DEFLECT_FLOOR=1: a turn that still hands the work back after its bounces leads with a lesson from its own chart', async () => {
+  const result = await handBackTeachTurn('1');
+  assert.match(result.text, /^Here is what the code itself shows, read from the scan\. Follow the picture on the canvas: it starts at \*\*orders\.ts\*\* and leads to \*\*routes\.py\*\*\. Each arrow on that path is a connection the scan found in the code/);
+  assert.match(result.text, /A real example from this code: `gateway\/src\/routes\/[a-z]+\.ts:\d+`/);
+  /* The model's own words are kept, after the lesson. */
+  assert.ok(result.text.includes('Can you confirm which files'));
+});
+
+test('askPipeline teach deflection floor stays off without the flag', async () => {
+  const result = await handBackTeachTurn(undefined);
+  assert.doesNotMatch(result.text, /Here is what the code itself shows/);
+});
+
+test('askPipeline teach: the picture pointer reads the chart the MODEL drew, not only the product floor', async () => {
+  const repo = shopfrontRepo();
+  const LESSON =
+    'The gateway route file forwards every order request to the orders service, which answers it from its routes module. ' +
+    'That hop is a plain HTTP call, so when the orders service is slow the gateway waits too, and the customer sees the delay at checkout. ' +
+    'What would the gateway do if the orders service stopped answering?';
+  const { callProvider } = makeProviderScript([
+    {
+      text: 'Drawing it.',
+      toolRequests: [
+        {
+          id: 'c1',
+          name: 'propose_chart',
+          args: {
+            kind: 'data-flow',
+            title: 'An order request',
+            items: [
+              { id: 'g', label: 'orders.ts', nodeId: 'file:gateway/src/routes/orders.ts' },
+              { id: 'o', label: 'routes.py', nodeId: 'file:orders/app/routes.py' },
+            ],
+            links: [{ from: 'g', to: 'o', label: 'HTTP' }],
+          },
+        },
+      ],
+    },
+    { text: LESSON },
+  ]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const before = process.env.SEQUENCE_TEACH_PICTURE_POINTER;
+  process.env.SEQUENCE_TEACH_PICTURE_POINTER = '1';
+  try {
+    const result = await runAskPipeline({ ...base, question: 'Teach me how an order request travels', teach: true }, () => {});
+    assert.match(result.text, /On the canvas, start at \*\*orders\.ts\*\* and follow the arrow to \*\*routes\.py\*\*\./);
+    /* Still before the closing question. */
+    assert.match(result.text.trim(), /\?$/);
+  } finally {
+    if (before === undefined) delete process.env.SEQUENCE_TEACH_PICTURE_POINTER;
