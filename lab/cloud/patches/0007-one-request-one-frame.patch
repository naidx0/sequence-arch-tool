+  const repo = shopfrontRepo();
+  const chart = (id: string, title: string, labels: string[]) => ({
+    id,
+    name: 'propose_chart',
+    args: { kind: 'data-flow', title, items: labels.map((l, i) => ({ id: `i${i}`, label: l })) },
