+  const { callProvider } = makeProviderScript([
+    { text: 'Drawing.', toolRequests: [chart('c1', 'How an order moves', ['Gateway', 'Orders', 'Postgres'])] },
+    {
+      text: 'Fixing the picture, and adding the storage.',
+      toolRequests: [
+        chart('c2', 'How an order moves', ['Gateway', 'Orders', 'Postgres', 'Events']),
+        chart('c3', 'Where order data lives', ['Tables', 'Migrations']),
+      ],
+    },
