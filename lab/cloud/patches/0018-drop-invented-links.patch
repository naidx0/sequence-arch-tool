index 1ab21bf..344ad58 100644
--- a/packages/schema/src/chart.ts
+++ b/packages/schema/src/chart.ts
@@ -444,3 +444,133 @@ export function groundingEdgeKeys(
   }
   return keys;
 }
+
+export interface BridgeResult {
+  chart: SeqChart;
+  /** Refused links replaced by the one shortest route the scan has. */
+  bridged: number;
+  /** Refused links with no route, or more than one equally short route. */
+  dropped: number;
+  /** Parts that name nothing in the scan, removed with their links. */
+  droppedParts: number;
+}
+
+/**
+ * Repairs a refused chart in code instead of asking the model again. A link
+ * the scan doesn't have is replaced by the scan's shortest route between the
+ * same two parts (at most `maxHops` hops) when exactly one such route exists,
+ * adding the parts in between. Any other refused link is dropped, and so is
+ * any part that names nothing in the scan. What comes out passes
+ * validateChart against the same node and edge sets.
+ */
+export function bridgeChart(
+  chart: SeqChart,
+  known: ReadonlySet<string>,
+  knownEdges: ReadonlySet<string>,
+  labelOf: (nodeId: string) => string,
+  maxHops = 3,
+): BridgeResult {
+  const out = new Map<string, string[]>();
+  for (const k of knownEdges) {
+    const at = k.indexOf('>');
+    const a = k.slice(0, at);
+    const list = out.get(a) ?? [];
+    list.push(k.slice(at + 1));
+    out.set(a, list);
+  }
+  const kept = chart.items.filter((it) => typeof it.nodeId === 'string' && known.has(it.nodeId));
+  const droppedParts = chart.items.length - kept.length;
+  const items = kept.map((it) => ({ ...it }));
+  const itemOfNode = new Map<string, string>();
+  const nodeOfItem = new Map<string, string>();
+  for (const it of items) {
+    nodeOfItem.set(it.id, it.nodeId as string);
+    if (!itemOfNode.has(it.nodeId as string)) itemOfNode.set(it.nodeId as string, it.id);
+  }
+  const ids = new Set(items.map((it) => it.id));
+  const itemFor = (nodeId: string): string => {
+    const have = itemOfNode.get(nodeId);
+    if (have !== undefined) return have;
+    let n = 1;
+    while (ids.has(`via${n}`)) n += 1;
+    const id = `via${n}`;
+    ids.add(id);
+    items.push({ id, label: labelOf(nodeId), nodeId });
+    itemOfNode.set(nodeId, id);
+    nodeOfItem.set(id, nodeId);
+    return id;
+  };
+  const links: ChartLink[] = [];
+  const seen = new Set<string>();
+  const push = (l: ChartLink) => {
+    const key = `${l.from}>${l.to}`;
+    if (seen.has(key)) return;
+    seen.add(key);
+    links.push(l);
+  };
+  let bridged = 0;
+  let dropped = 0;
+  for (const l of chart.links ?? []) {
+    const a = nodeOfItem.get(l.from);
+    const z = nodeOfItem.get(l.to);
+    if (a === undefined || z === undefined) {
+      dropped += 1;
+      continue;
+    }
+    if (knownEdges.has(`${a}>${z}`)) {
+      push({ ...l });
+      continue;
+    }
+    const route = onlyShortestRoute(out, a, z, maxHops);
+    if (route === undefined) {
+      dropped += 1;
+      continue;
+    }
+    bridged += 1;
+    for (let k = 1; k < route.length; k += 1) {
+      const from = k === 1 ? l.from : itemFor(route[k - 1]);
+      const to = k === route.length - 1 ? l.to : itemFor(route[k]);
+      push(k === 1 && l.label !== undefined ? { from, to, label: l.label } : { from, to });
+    }
+  }
+  const next: SeqChart = { ...chart, items, links };
+  if (next.focusItemId !== undefined && !ids.has(next.focusItemId)) delete next.focusItemId;
+  return { chart: next, bridged, dropped, droppedParts };
+}
+
+/** The route from a to z when it is the only shortest one within maxHops (and longer than one hop). */
+function onlyShortestRoute(
+  out: ReadonlyMap<string, readonly string[]>,
+  a: string,
+  z: string,
+  maxHops: number,
+): string[] | undefined {
+  const count = new Map<string, number>([[a, 1]]);
+  const prev = new Map<string, string>();
+  const depth = new Map<string, number>([[a, 0]]);
+  let frontier = [a];
+  for (let d = 1; d <= maxHops && frontier.length > 0; d += 1) {
+    const next: string[] = [];
+    for (const u of frontier) {
+      for (const v of out.get(u) ?? []) {
+        const dv = depth.get(v);
+        if (dv === undefined) {
+          depth.set(v, d);
+          count.set(v, count.get(u) ?? 0);
+          prev.set(v, u);
+          next.push(v);
+        } else if (dv === d) {
+          count.set(v, (count.get(v) ?? 0) + (count.get(u) ?? 0));
+        }
+      }
+    }
+    if (depth.get(z) === d) {
+      if (count.get(z) !== 1 || d < 2) return undefined;
+      const route = [z];
+      while (route[0] !== a) route.unshift(prev.get(route[0]) as string);
+      return route;
+    }
+    frontier = next;
+  }
+  return undefined;
+}
