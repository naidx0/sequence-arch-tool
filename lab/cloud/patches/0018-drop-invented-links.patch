@@ -0,0 +1,67 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { bridgeChart, groundingEdgeKeys, validateChart, type SeqChart } from './index.js';
+
+/*
+ * gateway -> routes -> client -> stripe, plus two routes from routes to db, so
+ * a skipped hop to db has no single answer. invoice reaches nothing.
+ */
+const EDGES = [
+  { srcId: 'gateway', dstId: 'routes' },
+  { srcId: 'routes', dstId: 'client' },
+  { srcId: 'client', dstId: 'stripe' },
+  { srcId: 'routes', dstId: 'models' },
+  { srcId: 'routes', dstId: 'repo' },
+  { srcId: 'models', dstId: 'db' },
+  { srcId: 'repo', dstId: 'db' },
+  { srcId: 'invoice', dstId: 'db' },
+];
+const NODES = new Set(['gateway', 'routes', 'client', 'stripe', 'models', 'repo', 'db', 'invoice']);
+const KEYS = groundingEdgeKeys(EDGES);
+const label = (id: string) => `${id}.py`;
+
+function chart(parts: string[], links: [string, string][]): SeqChart {
+  return {
+    version: 1,
+    kind: 'data-flow',
+    title: 't',
+    items: parts.map((p) => ({ id: p, label: p, nodeId: p })),
+    links: links.map(([from, to]) => ({ from, to })),
+  };
+}
+
+test('a skipped hop with one shortest route is filled in from the scan', () => {
+  const r = bridgeChart(chart(['gateway', 'client'], [['gateway', 'client']]), NODES, KEYS, label);
+  assert.equal(r.bridged, 1);
+  assert.equal(r.dropped, 0);
+  assert.deepEqual(
+    r.chart.links?.map((l) => `${l.from}>${l.to}`),
+    ['gateway>via1', 'via1>client'],
+  );
+  assert.deepEqual(r.chart.items[2], { id: 'via1', label: 'routes.py', nodeId: 'routes' });
+  assert.equal(validateChart(r.chart, NODES, KEYS).ok, true);
+});
+
+test('an invented link with no route, or two equally short ones, is dropped and the parts stay', () => {
+  const r = bridgeChart(
+    chart(['invoice', 'client', 'routes', 'db'], [['invoice', 'client'], ['routes', 'db']]),
+    NODES,
+    KEYS,
+    label,
+  );
+  assert.equal(r.bridged, 0);
+  assert.equal(r.dropped, 2);
+  assert.equal(r.chart.items.length, 4);
+  assert.equal(r.chart.links?.length, 0);
+  assert.equal(validateChart(r.chart, NODES, KEYS).ok, true);
+});
+
+test('real links are kept as drawn; a part the scan lacks goes with its links', () => {
+  const c = chart(['gateway', 'routes', 'ghost'], [['gateway', 'routes'], ['routes', 'ghost']]);
+  c.links![0].label = 'POST /orders';
+  const r = bridgeChart(c, NODES, KEYS, label);
+  assert.equal(r.droppedParts, 1);
+  assert.deepEqual(r.chart.links, [{ from: 'gateway', to: 'routes', label: 'POST /orders' }]);
+  assert.equal(validateChart(chart(['gateway', 'routes', 'ghost'], [['gateway', 'routes']]), NODES, KEYS).ok, false);
+  assert.equal(validateChart(r.chart, NODES, KEYS).ok, true);
+});
