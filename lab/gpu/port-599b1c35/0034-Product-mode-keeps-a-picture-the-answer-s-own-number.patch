       const aimedPathOnHand =
         input.teachContext?.subjectNotInRepo !== true &&
         traceFlowsThisTurn.some((t) => gatheredFlows.has(t) && t.to !== undefined);
+      /* A PRODUCT ANSWER KEEPS A PICTURE (blind check 2, 2026-09-24: product mode lost
