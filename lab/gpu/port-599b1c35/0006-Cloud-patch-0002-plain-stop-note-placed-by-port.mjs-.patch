     'tools-only empty ending must record ceiling or no-progress stop reason',
   );
   assert.ok(result.metrics!.rounds > 0, 'tool rounds ran before the forced final answer');
-  assert.match(result.text, /tool (rounds|call)/i, 'forced answer names why tools stopped');
-  assert.match(result.text, /read_file/, 'forced answer summarizes what tools ran');
+  assert.match(result.text, /\b(?:tool rounds|rounds brought back|time budget)\b/i, 'forced answer names why tools stopped');
+  assert.match(result.text, /opened files/, 'forced answer summarizes what tools ran, in plain words');
+  assert.doesNotMatch(result.text, /read_file/, 'the stop note never reads a tool name out to the person');
 });
 
 test('askPipeline: design mode refuses tool requests (no fabricated files)', async () => {
@@ -5308,6 +5309,15 @@ test('subject not in the repo: a chart the MODEL drew still says where it came f
   );
 });
 
+test('the stop note names what the turn did in plain words, never a tool name', async () => {
+  const { summarizeExecutedTools } = await import('../server/askPipeline.js');
+  const note = summarizeExecutedTools(['read_topology', 'propose_topology', 'read_topology']);
+  assert.strictEqual(note, ' Before stopping I read the architecture and drew on the architecture board (3 steps).');
+  assert.strictEqual(summarizeExecutedTools(['read_file']), ' Before stopping I opened files (1 step).');
+  assert.match(summarizeExecutedTools(['canvas.write_markdown', 'mystery_tool', 'search_files']), /wrote on the canvas, looked things up and searched the code/);
+  assert.strictEqual(summarizeExecutedTools([]), '');
+});
+
 /* ============================ the forced round asks for the named surface ===== */
 
 test('drawSurfaceFor: the arch board is asked for the board, whatever else is live', () => {
