+/**
+ * INVENTED LINKS, DROPPED IN CODE, WHEN ON. `SEQUENCE_CHART_DROP_INVENTED_LINKS=1`
+ * turns a chart refused ONLY for links between real parts that the scan lacks
+ * into the same chart without those links, instead of a refusal the model has
+ * to redraw.
+ *
+ * Measured live on MiniCPM5 (sequence-lab log, 2026-09-23): on the hard shopfront
+ * set, with this repair on, DOT and path charts ground on 76% and 83% of fresh
+ * answers against 43% for JSON; without it no language beats JSON. The cloud
+ * stand-in found asking again deletes real branches (hop coverage 0.907 vs 0.971).
+ *
+ * Anything else stays a refusal: a part the scan lacks, an ambiguous name, a
+ * malformed chart, and a chart whose EVERY link was invented, because boxes
+ * joined to nothing no longer draw what was asked (25 of 210 repaired MiniCPM5
+ * charts). The model is told which links were left out, so its prose does not
+ * describe them as real.
+ */
+export function chartDropInventedLinksEnabled(): boolean {
+  return process.env.SEQUENCE_CHART_DROP_INVENTED_LINKS === '1';
+}
+
+function withoutInventedLinks(
+  raw: unknown,
+  problems: readonly { path: string; message: string }[],
+): { raw: unknown; leftOut: string[] } | undefined {
+  if (raw === null || typeof raw !== 'object' || problems.length === 0) return undefined;
+  const links = (raw as { links?: unknown }).links;
+  if (!Array.isArray(links)) return undefined;
+  const drop = new Set<number>();
+  const leftOut: string[] = [];
+  for (const p of problems) {
+    const at = /^links\[(\d+)\]$/.exec(p.path);
+    const edge = /^no edge (\S+) -> (\S+) in this repository/.exec(p.message);
+    if (!at || !edge) return undefined;
+    drop.add(Number(at[1]));
+    leftOut.push(`${edge[1]} -> ${edge[2]}`);
+  }
+  if (drop.size >= links.length) return undefined;
+  return { raw: { ...(raw as object), links: links.filter((_, i) => !drop.has(i)) }, leftOut };
+}
+
