+/* ============================================ one request, one frame ===== */
+
+test('askPipeline: a same-turn redraw of a chart is marked to replace it; a different chart is not', async () => {
+  const repo = shopfrontRepo();
+  const chart = (id: string, title: string, labels: string[]) => ({
+    id,
+    name: 'propose_chart',
+    args: { kind: 'data-flow', title, items: labels.map((l, i) => ({ id: `i${i}`, label: l })) },
+  });
+  const { callProvider } = makeProviderScript([
+    { text: 'Drawing.', toolRequests: [chart('c1', 'How an order moves', ['Gateway', 'Orders', 'Postgres'])] },
+    {
+      text: 'Fixing the picture, and adding the storage.',
+      toolRequests: [
+        chart('c2', 'How an order moves', ['Gateway', 'Orders', 'Postgres', 'Events']),
+        chart('c3', 'Where order data lives', ['Tables', 'Migrations']),
+      ],
+    },
+    { text: 'An order enters at the gateway and is stored by orders.' },
+  ]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const events: AskStreamEvent[] = [];
+  await runAskPipeline({ ...base, question: 'Draw how an order moves through the system' }, (e) => events.push(e));
+  const charts = events.filter((e) => e.type === 'chart:proposal') as Array<{ chart: { title: string; items: unknown[] }; replacesTurnChart?: number }>;
+  assert.deepStrictEqual(
+    charts.map((c) => [c.chart.title, c.chart.items.length, c.replacesTurnChart]),
+    [
+      ['How an order moves', 3, undefined],
+      ['How an order moves', 4, 0],
+      ['Where order data lives', 2, undefined],
+    ],
+  );
+});
+
+test('askPipeline: the same picture on another surface is a new frame there, not a redraw', async () => {
+  const repo = shopfrontRepo();
+  const chart = (id: string, labels: string[], surface?: string) => ({
+    id,
+    name: 'propose_chart',
+    args: { kind: 'data-flow', title: 'How an order moves', ...(surface ? { surface } : {}), items: labels.map((l, i) => ({ id: `i${i}`, label: l })) },
+  });
+  const { callProvider } = makeProviderScript([
+    { text: 'Drawing.', toolRequests: [chart('c1', ['Gateway', 'Orders'])] },
+    { text: 'And on the plan tab.', toolRequests: [chart('c2', ['Gateway', 'Orders'], 'plan')] },
+    { text: 'An order enters at the gateway.' },
+  ]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const events: AskStreamEvent[] = [];
+  await runAskPipeline({ ...base, question: 'Draw how an order moves through the system' }, (e) => events.push(e));
+  const charts = events.filter((e) => e.type === 'chart:proposal') as Array<{ surface?: string; replacesTurnChart?: number }>;
+  assert.deepStrictEqual(
+    charts.map((c) => [c.surface, c.replacesTurnChart]),
+    [
+      [undefined, undefined],
+      ['plan', undefined],
+    ],
+  );
+});
+
