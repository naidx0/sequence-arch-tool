diff --git a/packages/analyzer/src/test/ask-tool-loop.test.ts b/packages/analyzer/src/test/ask-tool-loop.test.ts
index c9a642c0..e86e6499 100644
--- a/packages/analyzer/src/test/ask-tool-loop.test.ts
+++ b/packages/analyzer/src/test/ask-tool-loop.test.ts
@@ -7612,3 +7612,36 @@ test('askPipeline teach, repeat guard off: the repeated draft goes out as before
   const result = await repeatTeachTurn(undefined);
   assert.match(result.text, /hands it to the orders service/);
 });
+
+test('askPipeline teach, repeat guard: a retry is sampled hot, and a draft still repeating after two retries becomes a short turn', async () => {
+  const repo = shopfrontRepo();
+  const { callProvider } = makeProviderScript([{ text: LAST_ANSWER }, { text: LAST_ANSWER }, { text: LAST_ANSWER }]);
+  const temps: unknown[] = [];
+  const recording = ((c: { params?: { temperature?: unknown } }, ...rest: unknown[]) => {
+    temps.push(c.params?.temperature);
+    return (callProvider as (...a: unknown[]) => unknown)(c, ...rest);
+  }) as typeof callProvider;
+  const base = await makeAttachedInput(repo, recording);
+  const before = process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+  process.env.SEQUENCE_TEACH_REPEAT_GUARD = '1';
+  try {
+    const result = await runAskPipeline(
+      {
+        ...base,
+        question: 'i still dont get it, why does it exist?',
+        teach: true,
+        historyLines: ['User: what is this app?', `Assistant: ${LAST_ANSWER}`],
+      },
+      () => {},
+    );
+    const { REPEAT_FALLBACK } = await import('../server/askPipeline.js');
+    assert.equal(result.text.trim(), REPEAT_FALLBACK);
+    assert.equal(temps.length, 3);
+    assert.notEqual(temps[0], 0.8);
+    assert.equal(temps[1], 0.8);
+    assert.equal(temps[2], 0.8);
+  } finally {
+    if (before === undefined) delete process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+    else process.env.SEQUENCE_TEACH_REPEAT_GUARD = before;
+  }
+});
