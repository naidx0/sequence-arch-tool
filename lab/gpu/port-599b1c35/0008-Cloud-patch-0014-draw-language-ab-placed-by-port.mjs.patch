+      const { user } = JSON.parse(fs.readFileSync(path.join(dir, `${q.id}.${l}.json`), 'utf8'));
+      for (const run of [1, 2, 3]) fs.writeFileSync(path.join(dir, `${q.id}.${l}.r${run}.txt`), cannedAnswer(l === 'path' ? 'path' : 'json', q, run, user));
+    }
