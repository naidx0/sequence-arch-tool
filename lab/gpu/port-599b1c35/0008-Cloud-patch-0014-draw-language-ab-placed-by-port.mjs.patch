+      { from: 'svc', to: 'platform', label: 'contains' },
+      { from: 'svc', to: 'panes', label: 'contains' },
+      { from: 'svc', to: 'readers', label: 'contains' },
+      { from: 'svc', to: 'engine', label: 'contains' },
+      { from: 'svc', to: 'ui', label: 'contains' },
+      { from: 'svc', to: 'shims', label: 'contains' },
