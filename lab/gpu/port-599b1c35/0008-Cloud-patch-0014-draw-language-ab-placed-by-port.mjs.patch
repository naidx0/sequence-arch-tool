+    {
+      "id": "mlh-diagnosis",
+      "question": "Where does app/main.py hand a failing run to diagnosis? Draw the hop.",
+      "focus": ["app/main.py", "app/diagnosis.py"],
+      "expectPath": ["app/main.py", "app/diagnosis.py"]
+    },
+    {
+      "id": "mlh-whole-ask",
+      "question": "Draw the whole ask: from the frontend client to the server, then to the providers and to diagnosis.",
+      "focus": ["frontend/src/lib/engine/client.ts", "app/main.py", "app/providers/__init__.py", "app/diagnosis.py"],
+      "expectPath": [
+        ["frontend/src/lib/engine/client.ts", "app/main.py", "app/providers/__init__.py"],
+        ["app/main.py", "app/diagnosis.py"]
+      ]
+    },
+    {
+      "id": "mlh-who-calls-providers",
+      "question": "What calls app/providers/__init__.py? Draw every caller with an arrow to it.",
+      "focus": ["app/providers/__init__.py"],
+      "expectPath": ["app/main.py", "app/providers/__init__.py"]
+    }
+  ]
+}
