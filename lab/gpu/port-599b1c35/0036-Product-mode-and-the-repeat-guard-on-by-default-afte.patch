@@ -7608,7 +7607,7 @@ test('askPipeline teach, SEQUENCE_TEACH_REPEAT_GUARD=1: a draft that repeats the
   assert.doesNotMatch(result.text, /hands it to the orders service/);
 });
 
-test('askPipeline teach, repeat guard off: the repeated draft goes out as before', async () => {
+test('askPipeline teach, SEQUENCE_TEACH_REPEAT_GUARD=0: the repeated draft goes out as before', async () => {
   const result = await repeatTeachTurn(undefined);
   assert.match(result.text, /hands it to the orders service/);
 });
@@ -7645,3 +7644,20 @@ test('askPipeline teach, repeat guard: a retry is sampled hot, and a draft still
     else process.env.SEQUENCE_TEACH_REPEAT_GUARD = before;
   }
 });
+
+test('askPipeline teach, repeat guard is ON by default (SEQUENCE_TEACH_REPEAT_GUARD unset)', async () => {
+  const repo = shopfrontRepo();
+  const { callProvider } = makeProviderScript([{ text: LAST_ANSWER }, { text: NEW_ANSWER }]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const before = process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+  delete process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+  try {
+    const result = await runAskPipeline(
+      { ...base, question: 'i still dont get it, why does it exist?', teach: true, historyLines: ['User: what is this app?', `Assistant: ${LAST_ANSWER}`] },
+      () => {},
+    );
+    assert.match(result.text, /shop counter/);
+  } finally {
+    if (before !== undefined) process.env.SEQUENCE_TEACH_REPEAT_GUARD = before;
+  }
+});
