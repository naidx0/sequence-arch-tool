From 167fa06c9307447d2c08c209dcaeffef8e295640 Mon Sep 17 00:00:00 2001
From: maxnaid1 <maxnaid41@gmail.com>
Date: Wed, 23 Sep 2026 14:35:11 -0400
Subject: [PATCH 03/37] Cloud patch 0015-canvas-read-once, applied clean at
 599b1c35

---
 packages/web2/src/state/canvasRestore.test.tsx | 12 ++++++++++++
 packages/web2/src/state/connect.tsx            |  8 ++++++++
 2 files changed, 20 insertions(+)

diff --git a/packages/web2/src/state/canvasRestore.test.tsx b/packages/web2/src/state/canvasRestore.test.tsx
index 9ee46702..c7ffa3a0 100644
--- a/packages/web2/src/state/canvasRestore.test.tsx
+++ b/packages/web2/src/state/canvasRestore.test.tsx
@@ -114,6 +114,18 @@ describe('the AI Canvas is restored from disk', () => {
     await waitFor(() => expect(calls.some((u) => u.startsWith('/api/canvas-doc'))).toBe(true));
   });
 
+  it('asks ONCE, after the index has named the thread', async () => {
+    /* A read before the index names a thread has nowhere to land, and the
+       latch reopens when the id arrives, so a cold load used to ask twice and
+       drop the first answer. */
+    const { store, calls } = mount(SAVED_CANVAS);
+    await waitFor(() => expect(store.getState().session.canvasDoc.blocks.length).toBe(2));
+    await new Promise((r) => setTimeout(r, 50));
+    const canvasReads = calls.filter((u) => u.startsWith('/api/canvas-doc'));
+    expect(canvasReads).toHaveLength(1);
+    expect(calls.indexOf('/api/sessions')).toBeLessThan(calls.indexOf(canvasReads[0]!));
+  });
+
   it('PUTS THE SAVED BLOCKS BACK IN THE STORE, with their content intact', async () => {
     const { store } = mount(SAVED_CANVAS);
 
diff --git a/packages/web2/src/state/connect.tsx b/packages/web2/src/state/connect.tsx
index d4db71ec..74554288 100644
--- a/packages/web2/src/state/connect.tsx
+++ b/packages/web2/src/state/connect.tsx
@@ -1379,6 +1379,14 @@ export function ConnectedChatColumn() {
 
   useEffect(() => {
     if (canvasHydrated.current || !canvasEmpty || state.session.inFlight !== null) return undefined;
+    /*
+     * NO THREAD, NO READ. Before the session index names a thread the answer
+     * has nowhere to land (`forSession` below is null and it is dropped), and
+     * the latch reopens when the id arrives, so a fetch here was a wasted GET
+     * on every cold load: measured in Chromium, `/api/canvas-doc` twice at
+     * boot, the first one always discarded. The latch stays open until then.
+     */
+    if (!activeSessionId) return undefined;
     canvasHydrated.current = true;
     const controller = new AbortController();
     void fetch('/api/canvas-doc', { signal: controller.signal })
