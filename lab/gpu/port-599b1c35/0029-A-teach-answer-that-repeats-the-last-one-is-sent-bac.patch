diff --git a/packages/analyzer/src/test/ask-tool-loop.test.ts b/packages/analyzer/src/test/ask-tool-loop.test.ts
index cf228507..c9a642c0 100644
--- a/packages/analyzer/src/test/ask-tool-loop.test.ts
+++ b/packages/analyzer/src/test/ask-tool-loop.test.ts
@@ -7571,3 +7571,44 @@ test('askPipeline teach deflection floor, =drop: the hand-back sentence is gone
   /* The model's other sentence survives. */
   assert.ok(result.text.includes('I have looked at the scan.'));
 });
+
+/* ======================================== an answer is not sent twice ===== */
+
+const LAST_ANSWER =
+  'The shopfront is a set of services: the gateway takes the request and hands it to the orders service, which stores it in postgres and tells the other services through a queue. Did this make sense so far?';
+const NEW_ANSWER =
+  'Think of it as a shop counter: a customer places an order, the counter checks stock and payment, and then shipping and notifications hear about it. What would you check first if an order never shipped?';
+
+async function repeatTeachTurn(flag: string | undefined) {
+  const repo = shopfrontRepo();
+  const { callProvider } = makeProviderScript([{ text: LAST_ANSWER }, { text: NEW_ANSWER }]);
+  const base = await makeAttachedInput(repo, callProvider);
+  const before = process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+  if (flag === undefined) delete process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+  else process.env.SEQUENCE_TEACH_REPEAT_GUARD = flag;
+  try {
+    return await runAskPipeline(
+      {
+        ...base,
+        question: 'i still dont get it, why does it exist?',
+        teach: true,
+        historyLines: ['--- PRIOR CHAT (same workspace; continue coherently) ---', 'User: what is this app?', `Assistant: ${LAST_ANSWER}`],
+      },
+      () => {},
+    );
+  } finally {
+    if (before === undefined) delete process.env.SEQUENCE_TEACH_REPEAT_GUARD;
+    else process.env.SEQUENCE_TEACH_REPEAT_GUARD = before;
+  }
+}
+
+test('askPipeline teach, SEQUENCE_TEACH_REPEAT_GUARD=1: a draft that repeats the last answer is sent back once and the new answer goes out', async () => {
+  const result = await repeatTeachTurn('1');
+  assert.match(result.text, /shop counter/);
+  assert.doesNotMatch(result.text, /hands it to the orders service/);
+});
+
+test('askPipeline teach, repeat guard off: the repeated draft goes out as before', async () => {
+  const result = await repeatTeachTurn(undefined);
+  assert.match(result.text, /hands it to the orders service/);
+});
