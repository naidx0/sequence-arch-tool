-import { validateChart, CHART_KINDS, FLOW_KINDS, chartFamily, compileFlowLines, flowProblemLine, isChartKind } from '@sequence/schema';
+import { validateChart, CHART_KINDS, FLOW_KINDS, chartFamily, compileDrawing, compileFlowLines, flowProblemLine, isChartKind } from '@sequence/schema';
 import type { CompiledFlow } from '@sequence/schema';
 import type { Digest } from '../explain/explain.js';
 import {
@@ -4209,6 +4209,27 @@ export function chartFlowLinesEnabled(): boolean {
   return process.env.SEQUENCE_CHART_FLOW_LINES === '1';
 }
 
+/**
+ * A SMALL MODEL DRAWS IN GRAPHVIZ DOT, WHEN ON. `SEQUENCE_CHART_LANG=dot` publishes
+ * propose_chart with a `dot` argument (a digraph whose nodes are file paths) and
+ * compiles it into the same chart the JSON path builds, checked by the same
+ * validator. It turns on the invented-link drop (0018a) with it, because the
+ * measurement only holds with the repair.
+ *
+ * Measured live on MiniCPM5 (sequence-lab log, 2026-09-23), 126 fresh answers on the
+ * hard shopfront set with the repair on: DOT grounded 76% and hop coverage 0.48
+ * against JSON's 43% and 0.16 (paired by run, +0.33 SE 0.05 and +0.31 SE 0.07).
+ */
+export function chartLang(): 'json' | 'dot' {
+  return process.env.SEQUENCE_CHART_LANG === 'dot' ? 'dot' : 'json';
+}
+
+function dotArg(args: Record<string, unknown>): string | undefined {
+  if (chartLang() !== 'dot' || Array.isArray(args.items)) return undefined;
+  const dot = args.dot;
+  return typeof dot === 'string' && dot.trim() !== '' ? dot : undefined;
+}
+
 function flowLinesArg(args: Record<string, unknown>): string | undefined {
   if (!chartFlowLinesEnabled() || Array.isArray(args.items)) return undefined;
   const flow = args.flow;
@@ -4234,7 +4255,27 @@ function executeProposeChart(
 ): AskToolResult {
   const flow = flowLinesArg(args);
   let compiled: CompiledFlow | undefined;
-  if (flow !== undefined) {
+  const dot = dotArg(args);
+  if (dot !== undefined) {
+    const out = compileDrawing('dot', dot, {
+      head: {
+        kind: isChartKind(args.kind) ? args.kind : 'data-flow',
+        title: typeof args.title === 'string' ? args.title : '',
+        ...(typeof args.caption === 'string' ? { caption: args.caption } : {}),
+      },
+    });
+    if (!out.ok) {
+      return {
+        ok: false,
+        evidence: `refused: propose_chart — ${out.problems.slice(0, 6).map((p) => p.message).join('; ')}`,
+      };
+    }
+    /* A DOT node is named by its file, so that name is its claim: it becomes the
+       item's nodeId and goes through the same stem lookup and validator below. */
+    const items = out.chart.items.map((it) => (it.nodeId ? it : { ...it, nodeId: it.label }));
+    /* Same shape where it matters: chart, steps, itemLine and linkLine, which flowProblemLine reads. */
+    compiled = { ...out, chart: { ...out.chart, items } } as unknown as CompiledFlow;
+  } else if (flow !== undefined) {
     const out = compileFlowLines(flow, {
       kind: isChartKind(args.kind) ? args.kind : 'data-flow',
       title: typeof args.title === 'string' ? args.title : '',
@@ -4389,7 +4430,7 @@ function executeProposeChart(
  * describe them as real.
  */
 export function chartDropInventedLinksEnabled(): boolean {
-  return process.env.SEQUENCE_CHART_DROP_INVENTED_LINKS === '1';
+  return process.env.SEQUENCE_CHART_DROP_INVENTED_LINKS === '1' || chartLang() === 'dot';
 }
 
