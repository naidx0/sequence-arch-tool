+/**
+ * FLOW LINES, WHEN ON. `SEQUENCE_CHART_FLOW_LINES=1` lets `propose_chart` take
+ * `flow` instead of `items`/`links`: a few `a -> b: label | narration` lines
+ * (schema/src/flowLines.ts), compiled into the same chart and then grounded and
+ * validated exactly like a JSON one. Refusals come back per line.
+ *
+ * `flow` may be one string or an array of lines. The array is what the fence
+ * example teaches, because a multi-line string inside a JSON fence needs `\\n`
+ * escapes that a small model drops. Items/links win when both are sent, so a
+ * caller that already speaks JSON sees no change.
+ */
+export function chartFlowLinesEnabled(): boolean {
+  return process.env.SEQUENCE_CHART_FLOW_LINES === '1';
+}
+
+function flowLinesArg(args: Record<string, unknown>): string | undefined {
+  if (!chartFlowLinesEnabled() || Array.isArray(args.items)) return undefined;
+  const flow = args.flow;
+  if (typeof flow === 'string' && flow.trim() !== '') return flow;
+  if (Array.isArray(flow) && flow.length > 0 && flow.every((l) => typeof l === 'string')) {
+    return (flow as string[]).join('\n');
+  }
+  return undefined;
+}
