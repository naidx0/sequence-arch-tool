+   * must sit inside teach OR a plot/draw gate.
    */
   const CODE = PIPELINE.replace(/\/\*[\s\S]*?\*\//g, ' ').replace(/^\s*\/\/.*$/gm, ' ');
   const chartAssignments = [...CODE.matchAll(/lastChartThisTurn\s*=(?!=)/g)];
   assert.equal(
     chartAssignments.length,
-    4,
