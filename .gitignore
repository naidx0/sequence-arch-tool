node_modules/
dist/
# Per-project platform memory: design spec, canvas state, and — critically —
# the bring-your-own-key AI provider config (.sequence/ai.json holds an API key).
# None of it belongs in git; the key must never be committed.
.sequence/*
# The rules above are ANCHORED to this file's directory, so they only cover the repo
# ROOT .sequence/. Scanning a test fixture writes a graph cache into that FIXTURE's
# own .sequence/, which was landing in commits as noise — c9d7f2eb already removed one
# ("drop accidental shopfront .sequence cache from commit") and it came straight back,
# because the file was deleted without an ignore rule to stop it returning. These
# patterns are unanchored (no leading slash), so they match at any depth.
**/.sequence/graph.json
**/.sequence/functions.json
**/.sequence/cache/
# ...but shipped program TEMPLATES under .sequence/programs are source and DO ship
# (they carry no secrets — just a ProgramGraph + an honest $note).
!.sequence/programs/
.sequence/programs/*
!.sequence/programs/*.json
# ...and the SAME for per-org harness policies (G-E). A policy is a rule the org
# committed to its own repo — "no new sync call into the pricing path" — so it is
# SOURCE and must survive a fresh clone, or the harness silently stops enforcing
# what the team wrote down. No secrets: a policy names services and states a reason.
!.sequence/policies/
.sequence/policies/*
!.sequence/policies/*.json
# ...and the SAME for the permission rule algebra (P3 phase 2). The allow / ask
# / deny lists in .sequence/permissions.json are a rule the team wrote down —
# "never read **/*.env", "always ask before pnpm publish" — so it is SOURCE by
# the identical argument the policies block above makes, and §5.2 of
# docs/research/v2-architecture-and-gaps.md is explicit that a rule you cannot
# diff loses the argument for having rules at all. A permissions file this
# .gitignore swallowed would enforce correctly on one machine and vanish on a
# fresh clone. No secrets: it names tools and path globs.
!.sequence/permissions.json
*.tsbuildinfo
.pnpm-store/
.DS_Store
*.log
packages/web/public/archgraph.json
tmp/
# @sequence/desktop build/packaging outputs (assembled by scripts, not source)
packages/desktop/server-bundle/
packages/desktop/release/
tmp-shots/
tmp-moat-shots/
# QA-loop run output: per-run JSONL + summary + scanned graphs. Regenerated by
# `pnpm qa:smoke`; only tools/qa-loop/baseline.json is source and IS committed.
tools/qa-loop/runs/
.env
.env.*
.env.local
*.local.env
packages/**/.env
secrets.json

# Generated grounded-graph cache + spec/state under bundled example repos (never commit)
examples/**/.sequence/
.hermes/
.claude/worktrees/

.codex/

# Python bytecode caches: an absolute build path is baked into every .pyc, and
# examples/makemore/__pycache__ was carrying one into every clone.
__pycache__/
*.pyc

# The public mirror is rebuilt on demand; its staging tree and bare repo are not source.
tools/release/out/

# The scripted seat writes here on each run; a --dry transcript is not a seat read.
docs/journeys/seat/

# The skipper bench writes this on every run, and the counting gate runs every test
# on every push — so a tracked copy is rewritten constantly and swept into commits.
tools/bench/out/skipper-inventory.json

# The counting gate rewrites this on every push, so a tracked copy is always dirty.
tools/ci/out/counting-gate.json

# Rewritten by every bench run; skipper-eval reads it and refuses when absent.
tools/bench/out/teach-eval-report.json

# Bench arm reports: run artifacts, kept locally as evidence, not source.
tools/bench/out/seq-*.json
tools/bench/out/checkpoint-prediction.json
tools/bench/out/walk-*.json
tools/bench/out/nextpic-*.json
tools/bench/out/nextpic-*.json
tools/bench/out/ceiling-*.json
tools/bench/out/carry-*.json
tools/bench/out/belt-*.json
# Auto-named arm reports (repo-flags-instant). Same reason as the patterns
# above: one per arm, ~200KB each, and every measurement writes four. The
# NUMBERS live in docs/research/*-result*.md, which is what gets cited.
tools/bench/out/teach-eval-sequence-*.json
tools/bench/out/wireA-*.json
tools/bench/out/smoke-*.json
tools/bench/out/carry-referents-*.json
tools/bench/out/picture-*.json
tools/bench/out/picture-arm.log
tools/bench/out/discarded/
