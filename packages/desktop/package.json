{
  "name": "@sequence/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Sequence — a double-click window around the local architecture app, with a native OS folder picker for attaching a repo",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "dev": "electron .",
    "prepare-server": "node scripts/prepare-server.mjs",
    "dist": "node scripts/prepare-server.mjs && electron-builder",
    "clean": "rm -rf dist server-bundle release"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  }
}
