flowchart TD
    subgraph Services
        edge["edge"]
        inventory["inventory"]
        notifications["notifications"]
        gateway["gateway"]
        invoices["invoices"]
        orders["orders"]
        payments["payments"]
        shipping["shipping"]
    end
    subgraph Datastores
        postgres[("postgres")]
    end
    subgraph Topics
        topic_order_created{{"topic:order.created"}}
    end
    edge -->|/api/| gateway
    notifications -->|consume order.created| topic_order_created
    gateway -->|GET /invoices/*| invoices
    gateway -->|GET /orders/*, POST /orders| orders
    gateway -->|GET /payments/*| payments
    gateway -->|GET /shipments/*| shipping
    invoices -->|POST /charge| payments
    invoices -->|db, read invoices| postgres
    orders -->|grpc| inventory
    orders -->|POST /charge| payments
    orders -->|db, read orders, table orders, write orders| postgres
    orders -->|publish order.created| topic_order_created
    payments -->|db, read orders, read payments, write payments| postgres
    shipping -->|db, read shipments, write shipments| postgres
    shipping -->|consume order.created| topic_order_created
